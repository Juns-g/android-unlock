+func flymeTerminalConfirmation(_ initial: Snapshot, actions: Int, succeeded: Int, confirm: () -> Snapshot) -> Snapshot {
+    var after = initial
+    guard initial.target?.mode == .flymeFour, actions == 4, succeeded == 4 else {
+        after.reason = "flyme_terminal_dispatch_incomplete"; after.progressPhase = "terminal_lock_state_unconfirmed"; return after
+    }
+    // The fourth append callback may disappear with the authenticated field; no count is inferred.
+    after = confirm()
+    if consistent(initial, after), after.reason == "observed", after.secure, after.state == .unlocked {
+        after.progressPhase = "terminal_lock_state_transition"
+    } else {
+        if after.reason == "observed" { after.reason = "flyme_terminal_state_unconfirmed" }
+        after.progressPhase = "terminal_lock_state_unconfirmed"
+    }
+    return after
+}
